# Copy to .env.local and fill in. Never commit real values.

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# AI chat widget (/api/chat). Chat shows "not configured" when unset.
ANTHROPIC_API_KEY=
# Contact form email delivery via Resend (/api/contact). Falls back to mailto when unset.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "DevsRoute <hello@devsroute.com>"
CONTACT_FROM_EMAIL=

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=https://devsroute.com
# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional search-console verification tokens
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# Set to "mailto" to show the mailto hint on the contact page
NEXT_PUBLIC_CONTACT_HINT=
